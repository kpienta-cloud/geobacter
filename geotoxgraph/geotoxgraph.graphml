articles/PMC1183504/</data><data key="e_notes">VcrA completes the pathway from VC to non-toxic ethene, the terminal step Geobacter cannot complete.</data></edge><edge id="edge:ppu_kt2440_has_amine_module" source="strain:ppu_kt2440" target="module:ppu_aerobic_aromatic_amine"><data key="e_edge_id">edge:ppu_kt2440_has_amine_module</data><data key="e_predicate">has_module</data><data key="e_enzyme_or_system" /><data key="e_strain_id">ppu_kt2440</data><data key="e_module_id">ppu_aerobic_aromatic_amine</data><data key="e_evidence_tier">2</data><data key="e_evidence_type">genome_and_biochemistry</data><data key="e_effect">capability</data><data key="e_source_url">https://pubmed.ncbi.nlm.nih.gov/22367088/</data><data key="e_notes">Genome-encoded aerobic aromatic-amine oxidation module.</data></edge><edge id="edge:ppu_kt2440_has_pah_module" source="strain:ppu_kt2440" target="module:ppu_pah_ring_hydroxylation"><data key="e_edge_id">edge:ppu_kt2440_has_pah_module</data><data key="e_predicate">has_module</data><data key="e_enzyme_or_system" /><data key="e_strain_id">ppu_kt2440</data><data key="e_module_id">ppu_pah_ring_hydroxylation</data><data key="e_evidence_tier">2</data><data key="e_evidence_type">genome_and_biochemistry</data><data key="e_effect">capability</data><data key="e_source_url">https://pubmed.ncbi.nlm.nih.gov/16751444/</data><data key="e_notes">Genome-encoded ring-hydroxylating dioxygenase module.</data></edge><edge id="edge:ppu_bap_ring_hydroxylation" source="compound:bap" target="compound:bap_dihydrodiol"><data key="e_edge_id">edge:ppu_bap_ring_hydroxylation</data><data key="e_predicate">transformed_to</data><data key="e_enzyme_or_system">gene:ppu_ndo;gene:ppu_todc</data><data key="e_strain_id">ppu_kt2440</data><data key="e_module_id">ppu_pah_ring_hydroxylation</data><data key="e_evidence_tier">2</data><data key="e_evidence_type">biochemistry</data><data key="e_effect">aerobic_catabolism_entry</data><data key="e_source_url">https://pubmed.ncbi.nlm.nih.gov/16751444/</data><data key="e_notes">Aerobic ring-hydroxylating dioxygenase attack forms cis-dihydrodiol; distinct from mammalian CYP1A1/1B1 arene-oxide route.</data></edge><edge id="edge:ppu_4abp_deamination" source="compound:four_abp" target="compound:four_abp_deaminated"><data key="e_edge_id">edge:ppu_4abp_deamination</data><data key="e_predicate">transformed_to</data><data key="e_enzyme_or_system">gene:ppu_aaox</data><data key="e_strain_id">ppu_kt2440</data><data key="e_module_id">ppu_aerobic_aromatic_amine</data><data key="e_evidence_tier">2</data><data key="e_evidence_type">biochemistry</data><data key="e_effect">aerobic_deamination</data><data key="e_source_url">https://pubmed.ncbi.nlm.nih.gov/22367088/</data><data key="e_notes">Aerobic aromatic-amine oxidase attacks the amine group; product feeds downstream aerobic catabolism.</data></edge><edge id="edge:rho_erythropolis_has_afb1_module" source="strain:rho_erythropolis" target="module:rho_erythropolis_afb1_reduction"><data key="e_edge_id">edge:rho_erythropolis_has_afb1_module</data><data key="e_predicate">has_module</data><data key="e_enzyme_or_system" /><data key="e_strain_id">rho_erythropolis</data><data key="e_module_id">rho_erythropolis_afb1_reduction</data><data key="e_evidence_tier">2</data><data key="e_evidence_type">genome_and_biochemistry</data><data key="e_effect">capability</data><data key="e_source_url">https://pubmed.ncbi.nlm.nih.gov/23023529/</data><data key="e_notes">AFB1-reductase capacity documented in R. erythropolis and related actinomycetes.</data></edge><edge id="edge:rho_afb1_reduction" source="compound:afb1" target="compound:afb1_reduced"><data key="e_edge_id">edge:rho_afb1_reduction</data><data key="e_predicate">reduced_to</data><data key="e_enzyme_or_system">gene:rho_fdr_afb1</data><data key="e_strain_id">rho_erythropolis</data><data key="e_module_id">rho_erythropolis_afb1_reduction</data><data key="e_evidence_tier">2</data><data key="e_evidence_type">biochemistry</data><data key="e_effect">detoxification</data><data key="e_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC3187090/</data><data key="e_notes">F420-dependent reduction of AFB1 bisfuran ring; disables mammalian CYP1A2/3A4 bioactivation route.</data></edge><edge id="edge:rho_anm7_has_ndma_module" source="strain:rho_anm7" target="module:rho_anm7_ndma_degradation"><data key="e_edge_id">edge:rho_anm7_has_ndma_module</data><data key="e_predicate">has_module</data><data key="e_enzyme_or_system" /><data key="e_strain_id">rho_anm7</data><data key="e_module_id">rho_anm7_ndma_degradation</data><data key="e_evidence_tier">2</data><data key="e_evidence_type">genome_and_phenotype</data><data key="e_effect">capability</data><data key="e_source_url">https://pubmed.ncbi.nlm.nih.gov/16269791/</data><data key="e_notes">Growth on NDMA as sole N-source documented for Rhodococcus sp. ANM-7.</data></edge><edge id="edge:rho_ndma_to_methylamine" source="compound:ndma" target="compound:methylamine"><data key="e_edge_id">edge:rho_ndma_to_methylamine</data><data key="e_predicate">transformed_to</data><data key="e_enzyme_or_system">gene:rho_prmo_ndma</data><data key="e_strain_id">rho_anm7</data><data key="e_module_id">rho_anm7_ndma_degradation</data><data key="e_evidence_tier">2</data><data key="e_evidence_type">biochemistry</data><data key="e_effect">aerobic_catabolism_entry</data><data key="e_source_url">https://pubmed.ncbi.nlm.nih.gov/16269791/</data><data key="e_notes">Aerobic monooxygenase-mediated NDMA oxidation to methylamine and formaldehyde intermediates; distinct from CYP2E1 methylating route.</data></edge><edge id="edge:bthet_vpi5482_has_azo_module" source="strain:bthet_vpi5482" target="module:bthet_azo_reduction"><data key="e_edge_id">edge:bthet_vpi5482_has_azo_module</data><data key="e_predicate">has_module</data><data key="e_enzyme_or_system" /><data key="e_strain_id">bthet_vpi5482</data><data key="e_module_id">bthet_azo_reduction</data><data key="e_evidence_tier">1</data><data key="e_evidence_type">genome_and_biochemistry</data><data key="e_effect">capability</data><data key="e_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC5715131/</data><data key="e_notes">Azoreductase activity documented in Bacteroides thetaiotaomicron.</data></edge><edge id="edge:bthet_vpi5482_has_gus_module" source="strain:bthet_vpi5482" target="module:bthet_beta_glucuronidase"><data key="e_edge_id">edge:bthet_vpi5482_has_gus_module</data><data key="e_predicate">has_module</data><data key="e_enzyme_or_system" /><data key="e_strain_id">bthet_vpi5482</data><data key="e_module_id">bthet_beta_glucuronidase</data><data key="e_evidence_tier">1</data><data key="e_evidence_type">genome_and_biochemistry</data><data key="e_effect">capability</data><data key="e_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC5389526/</data><data key="e_notes">Loop-1 beta-glucuronidase encoded and active in B. thetaiotaomicron VPI-5482.</data></edge><edge id="edge:bthet_azo_to_4abp" source="compound:azo_4abp_dye" target="compound:four_abp"><data key="e_edge_id">edge:bthet_azo_to_4abp</data><data key="e_predicate">reduced_to</data><data key="e_enzyme_or_system">gene:bthet_azor</data><data key="e_strain_id">bthet_vpi5482</data><data key="e_module_id">bthet_azo_reduction</data><data key="e_evidence_tier">2</data><data key="e_evidence_type">biochemistry</data><data key="e_effect">reductive_cleavage</data><data key="e_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC5715131/</data><data key="e_notes">Gut azoreductase reduces azo-linked aromatic-amine precursors, releasing free 4-ABP into the lumen.</data></edge><edge id="edge:bthet_gus_deconjugates_afb1" source="compound:afb1_n7_gluc" target="compound:afb1"><data key="e_edge_id">edge:bthet_gus_deconjugates_afb1</data><data key="e_predicate">hydrolyzed_to</data><data key="e_enzyme_or_system">gene:bthet_gus</data><data key="e_strain_id">bthet_vpi5482</data><data key="e_module_id">bthet_beta_glucuronidase</data><data key="e_evidence_tier">2</data><data key="e_evidence_type">biochemistry</data><data key="e_effect">deconjugation</data><data key="e_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC5389526/</data><data key="e_notes">Loop-1 beta-glucuronidase deconjugates host AFB1-N7-guanine glucuronide, releasing the free carcinogen for reabsorption.</data></edge><edge id="edge:vpar_dsm2008_has_nitrate_module" source="strain:vpar_dsm2008" target="module:vpar_oral_nitrate_reduction"><data key="e_edge_id">edge:vpar_dsm2008_has_nitrate_module</data><data key="e_predicate">has_module</data><data key="e_enzyme_or_system" /><data key="e_strain_id">vpar_dsm2008</data><data key="e_module_id">vpar_oral_nitrate_reduction</data><data key="e_evidence_tier">1</data><data key="e_evidence_type">genome_and_biochemistry</data><data key="e_effect">capability</data><data key="e_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC4462107/</data><data key="e_notes">Napa-type periplasmic nitrate reduction documented for Veillonella parvula.</data></edge><edge id="edge:vpar_nitrate_to_nitrite" source="compound:nitrate" target="compound:nitrite"><data key="e_edge_id">edge:vpar_nitrate_to_nitrite</data><data key="e_predicate">reduced_to</data><data key="e_enzyme_or_system">gene:vpar_nap</data><data key="e_strain_id">vpar_dsm2008</data><data key="e_module_id">vpar_oral_nitrate_reduction</data><data key="e_evidence_tier">1</data><data key="e_evidence_type">biochemistry</data><data key="e_effect">entero_salivary_cycle</data><data key="e_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC4462107/</data><data key="e_notes">Oral nitrate reduction to nitrite; nitrite enters acidic stomach where N-nitrosation reactions may occur.</data></edge><edge id="edge:mvan_pyr1_has_pah_module" source="strain:mvan_pyr1" target="module:mvan_pyr1_highmw_pah"><data key="e_edge_id">edge:mvan_pyr1_has_pah_module</data><data key="e_predicate">has_module</data><data key="e_enzyme_or_system" /><data key="e_strain_id">mvan_pyr1</data><data key="e_module_id">mvan_pyr1_highmw_pah</data><data key="e_evidence_tier">1</data><data key="e_evidence_type">genome_biochemistry_metabolomics</data><data key="e_effect">capability</data><data key="e_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC3230965/</data><data key="e_notes">High-MW PAH degradation (pyrene, chrysene, benzo[a]pyrene) documented in M. vanbaalenii PYR-1.</data></edge><edge id="edge:mvan_pyrene_ring_hydroxylation" source="compound:pyrene" target="compound:pyrene_dihydrodiol"><data key="e_edge_id">edge:mvan_pyrene_ring_hydroxylation</data><data key="e_predicate">transformed_to</data><data key="e_enzyme_or_system">gene:mvan_nidab;gene:mvan_pdoab</data><data key="e_strain_id">mvan_pyr1</data><data key="e_module_id">mvan_pyr1_highmw_pah</data><data key="e_evidence_tier">1</data><data key="e_evidence_type">biochemistry</data><data key="e_effect">aerobic_catabolism_entry</data><data key="e_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC3230965/</data><data key="e_notes">NidAB and PdoAB dioxygenases catalyze initial ring-hydroxylation of pyrene; feeds aerobic meta-cleavage pathway.</data></edge><edge id="edge:mvan_bap_ring_hydroxylation" source="compound:bap" target="compound:bap_dihydrodiol"><data key="e_edge_id">edge:mvan_bap_ring_hydroxylation</data><data key="e_predicate">transformed_to</data><data key="e_enzyme_or_system">gene:mvan_nidab;gene:mvan_pdoab</data><data key="e_strain_id">mvan_pyr1</data><data key="e_module_id">mvan_pyr1_highmw_pah</data><data key="e_evidence_tier">2</data><data key="e_evidence_type">biochemistry</data><data key="e_effect">aerobic_catabolism_entry</data><data key="e_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC1489606/</data><data key="e_notes">NidAB and PdoAB dioxygenases attack benzo[a]pyrene at multiple ring positions; distinct from mammalian arene-oxide route.</data></edge><edge id="edge:gene:gme_Gmet_1538_member_of_gene:gmet_bsscab" source="gene:gme_Gmet_1538" target="gene:gmet_bsscab"><data key="e_edge_id">edge:gene:gme_Gmet_1