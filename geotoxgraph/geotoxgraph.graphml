>1,2-Dichloroethane</data><data key="n_node_type">compound</data><data key="n_strain_id" /><data key="n_module_id">geo_iae_organochlorine</data><data key="n_entity_class">organohalide</data><data key="n_identifier">PubChem:11</data><data key="n_description">Chlorinated ethane substrate dihaloeliminated by Geobacter sp. strain IAE</data><data key="n_source_url">https://www.osti.gov/servlets/purl/1860551</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid">11</data><data key="n_kegg_compound">C06752</data><data key="n_chebi_id">CHEBI:27789</data><data key="n_metacyc_candidate">1,2-DICHLOROETHANE</data><data key="n_metacyc_status">candidate_unverified</data><data key="n_annotation_status">compound_xref_enriched</data></node><node id="compound:1_1_2_tca"><data key="n_label">1,1,2-Trichloroethane</data><data key="n_node_type">compound</data><data key="n_strain_id" /><data key="n_module_id">geo_iae_organochlorine</data><data key="n_entity_class">organohalide</data><data key="n_identifier">PubChem:6574</data><data key="n_description">Chlorinated ethane substrate dihaloeliminated by Geobacter sp. strain IAE</data><data key="n_source_url">https://www.osti.gov/servlets/purl/1860551</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid">6574</data><data key="n_kegg_compound">C19536</data><data key="n_chebi_id">CHEBI:36018</data><data key="n_metacyc_candidate">1,1,2-TRICHLOROETHANE</data><data key="n_metacyc_status">candidate_unverified</data><data key="n_annotation_status">compound_xref_enriched</data></node><node id="compound:vinyl_chloride"><data key="n_label">Vinyl chloride</data><data key="n_node_type">compound</data><data key="n_strain_id" /><data key="n_module_id">geo_iae_organochlorine</data><data key="n_entity_class">organohalide_intermediate</data><data key="n_identifier">PubChem:6338</data><data key="n_description">Product of 1,1,2-TCA dihaloelimination and substrate for partner Dhc hydrogenolysis</data><data key="n_source_url">https://www.osti.gov/servlets/purl/1860551</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid">6338</data><data key="n_kegg_compound">C06793</data><data key="n_chebi_id">CHEBI:28509</data><data key="n_metacyc_candidate">VINYL-CHLORIDE</data><data key="n_metacyc_status">candidate_unverified</data><data key="n_annotation_status">compound_xref_enriched</data></node><node id="compound:ethene"><data key="n_label">Ethene</data><data key="n_node_type">compound</data><data key="n_strain_id" /><data key="n_module_id">geo_iae_organochlorine</data><data key="n_entity_class">detoxified_product</data><data key="n_identifier">PubChem:6325</data><data key="n_description">Benign dechlorination product from 1,2-DCA and final product in IAE-Dhc consortium</data><data key="n_source_url">https://www.osti.gov/servlets/purl/1860551</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid">6325</data><data key="n_kegg_compound">C06547</data><data key="n_chebi_id">CHEBI:18153</data><data key="n_metacyc_candidate">ETHYLENE</data><data key="n_metacyc_status">candidate_unverified</data><data key="n_annotation_status">compound_xref_enriched</data></node><node id="strain:dhc_195"><data key="n_label">Dehalococcoides mccartyi 195</data><data key="n_node_type">strain</data><data key="n_strain_id">dhc_195</data><data key="n_module_id" /><data key="n_entity_class">organism</data><data key="n_identifier">NCBI Taxonomy 243164</data><data key="n_description">Obligate organohalide-respiring anaerobe (Chloroflexota) that catalyzes complete reductive dechlorination of tetrachloroethene (PCE) through TCE, cis-DCE, and vinyl chloride to non-toxic ethene. Terminal-step dehalogenator distinct from Geobacter which stalls at cis-DCE.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC1183504/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="module:dhc_organohalide"><data key="n_label">Dehalococcoides complete-dechlorination module</data><data key="n_node_type">module</data><data key="n_strain_id">dhc_195</data><data key="n_module_id">dhc_organohalide</data><data key="n_entity_class">pathway_module</data><data key="n_identifier" /><data key="n_description">Sequential reductive-dehalogenase system (RdhA family): PceA (PCE to TCE), TceA (TCE to cis-DCE), VcrA and BvcA (cis-DCE and VC to ethene). Enables organohalide respiration to the terminal ethene product.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC1183504/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="gene:dhc_pcea"><data key="n_label">PceA reductive dehalogenase (Dhc)</data><data key="n_node_type">gene</data><data key="n_strain_id">dhc_195</data><data key="n_module_id">dhc_organohalide</data><data key="n_entity_class">enzyme_cluster</data><data key="n_identifier">DET0318 (pceA)</data><data key="n_description">First-step reductive dehalogenase; converts PCE to TCE.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC1183504/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="gene:dhc_tcea"><data key="n_label">TceA reductive dehalogenase (Dhc)</data><data key="n_node_type">gene</data><data key="n_strain_id">dhc_195</data><data key="n_module_id">dhc_organohalide</data><data key="n_entity_class">enzyme_cluster</data><data key="n_identifier">DET0079 (tceA)</data><data key="n_description">TCE-dechlorinating reductive dehalogenase; converts TCE to cis-DCE.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC1183504/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="gene:dhc_vcra"><data key="n_label">VcrA/BvcA reductive dehalogenase (Dhc)</data><data key="n_node_type">gene</data><data key="n_strain_id">dhc_195</data><data key="n_module_id">dhc_organohalide</data><data key="n_entity_class">enzyme_cluster</data><data key="n_identifier">vcrA (VS strain) / bvcA (BAV1)</data><data key="n_description">Terminal-step reductive dehalogenase; converts cis-DCE and VC to non-toxic ethene.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC1183504/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="strain:ppu_kt2440"><data key="n_label">Pseudomonas putida KT2440</data><data key="n_node_type">strain</data><data key="n_strain_id">ppu_kt2440</data><data key="n_module_id" /><data key="n_entity_class">organism</data><data key="n_identifier">NCBI Taxonomy 160488</data><data key="n_description">Aerobic soil pseudomonad; workhorse organism for oxidative aromatic and PAH catabolism. Multiple ring-hydroxylating dioxygenase systems including toluene/xylene monooxygenases, naphthalene dioxygenase, and aromatic amine oxidases. Distinct from Geobacter anaerobic route.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/12234232/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="module:ppu_aerobic_aromatic_amine"><data key="n_label">KT2440 aerobic aromatic-amine oxidation module</data><data key="n_node_type">module</data><data key="n_strain_id">ppu_kt2440</data><data key="n_module_id">ppu_aerobic_aromatic_amine</data><data key="n_entity_class">pathway_module</data><data key="n_identifier" /><data key="n_description">Oxidative pathway for arylamines and aromatic amines using aromatic-amine dehydrogenase and monoamine oxidase homologs. Handles primary aromatic amines including aniline and 4-aminobiphenyl.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/22367088/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="module:ppu_pah_ring_hydroxylation"><data key="n_label">KT2440 PAH ring-hydroxylation module</data><data key="n_node_type">module</data><data key="n_strain_id">ppu_kt2440</data><data key="n_module_id">ppu_pah_ring_hydroxylation</data><data key="n_entity_class">pathway_module</data><data key="n_identifier" /><data key="n_description">Ring-hydroxylating-dioxygenase system based on todC1C2 (toluene dioxygenase) and NahAaAbAcAd (naphthalene dioxygenase) homologs. Initiates oxidative attack on aromatic hydrocarbons including benzo[a]pyrene ring systems.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/16751444/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="gene:ppu_todc"><data key="n_label">TodC1C2 toluene dioxygenase (KT2440)</data><data key="n_node_type">gene</data><data key="n_strain_id">ppu_kt2440</data><data key="n_module_id">ppu_pah_ring_hydroxylation</data><data key="n_entity_class">enzyme_cluster</data><data key="n_identifier">PP_3268-PP_3269 (todC1 todC2 homologs)</data><data key="n_description">Ring-hydroxylating dioxygenase; initial oxidative attack on aromatic ring.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/12234232/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="gene:ppu_ndo"><data key="n_label">NdoB / naphthalene dioxygenase homolog (KT2440)</data><data key="n_node_type">gene</data><data key="n_strain_id">ppu_kt2440</data><data key="n_module_id">ppu_pah_ring_hydroxylation</data><data key="n_entity_class">enzyme_cluster</data><data key="n_identifier">PP_2569-PP_2571 (nahAaAb homologs)</data><data key="n_description">Naphthalene dioxygenase family enzyme active on PAH substrates including benzo[a]pyrene under some conditions.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/16751444/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="gene:ppu_aaox"><data key="n_label">Aromatic amine oxidase (KT2440)</data><data key="n_node_type">gene</data><data key="n_strain_id">ppu_kt2440</data><data key="n_module_id">ppu_aerobic_aromatic_amine</data><data key="n_entity_class">enzyme_cluster</data><data key="n_identifier">PP_maoP monoamine-oxidase homolog</data><data key="n_description">Oxidative deamination of aromatic amine substrates; distinct from mammalian NAT-mediated N-acetylation.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/22367088/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="compound:bap"><data key="n_label">Benzo[a]pyrene</data><data key="n_node_type">compound</data><data key="n_strain_id">shared</data><data key="n_module_id" /><data key="n_entity_class">polycyclic_aromatic_hydrocarbon</data><data key="n_identifier">BaP</data><data key="n_description">PAH exposure anchor; canonical CYP1A1/1B1 substrate in humans, aerobic dioxygenase substrate in bacteria.</data><data key="n_source_url">https://academic.oup.com/toxsci/article/145/1/5/1627571</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="compound:bap_dihydrodiol"><data key="n_label">BaP-7,8-cis-dihydrodiol (bacterial)</data><data key="n_node_type">compound</data><data key="n_strain_id">shared</data><data key="n_module_id" /><data key="n_entity_class">aromatic_intermediate</data><data key="n_identifier">BaP-7,8-diol</data><data key="n_description">cis-dihydrodiol product of bacterial dioxygenase attack on BaP; distinct from the CYP1A1-derived arene-oxide + trans-dihydrodiol that becomes BPDE in mammalian cells.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/16751444/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="compound:four_abp"><data key="n_label">4-Aminobiphenyl</data><data key="n_node_type">compound</data><data key="n_strain_id">shared</data><data key="n_module_id" /><data key="n_entity_class">aromatic_amine</data><data key="n_identifier">4-ABP</data><data key="n_description">Aromatic-amine bladder carcinogen; substrate for both bacterial aromatic-amine oxidase (aerobic deamination) and human CYP1A2 N-hydroxylation followed by NAT2 acetylation.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/22367088/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="compound:four_abp_deaminated"><data key="n_label">4-Aminobiphenyl aromatic-amine-oxidase product</data><data key="n_node_type">compound</data><data key="n_strain_id">shared</data><data key="n_module_id" /><data key="n_entity_class">aromatic_intermediate</data><data key="n_identifier">4-ABP_deaminated</data><data key="n_description">Bacterial aromatic-amine-oxidase-derived product; oxidative deamination distinct from mammalian N-hydroxylation/DNA-adduct pathway.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/22367088/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="strain:rho_erythropolis"><data key="n_label">Rhodococcus erythropolis</data><data key="n_node_type">strain</data><data key="n_strain_id">rho_erythropolis</data><data key="n_module_id" /><data key="n_entity_class">organism</data><data key="n_identifier">NCBI Taxonomy 1833</data><data key="n_description">Aerobic actinomycete with broad xenobiotic catabolism. Uses F420-dependent oxidoreductases (FDR-A/FDR-B family) to reduce the bisfuran ring of aflatoxin B1, opening the toxic lactone and disabling the CYP1A2-derived exo-8,9-epoxide bioactivation route. Distinct from mammalian bioactivation.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/23023529/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="module:rho_erythropolis_afb1_reduction"><data key="n_label">R. erythropolis AFB1-reductase module</data><data key="n_node_type">module</data><data key="n_strain_id">rho_erythropolis</data><data key="n_module_id">rho_erythropolis_afb1_reduction</data><data key="n_entity_class">pathway_module</data><data key="n_identifier" /><data key="n_description">F420-dependent oxidoreductase system for the reduction and detoxification of aflatoxin B1. Substrate: AFB1; product: less-toxic reduced AFB1 species.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/23023529/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="gene:rho_fdr_afb1"><data key="n_label">F420-dependent AFB1 reductase (Rhodococcus erythropolis)</data><data key="n_node_type">gene</data><data key="n_strain_id">rho_erythropolis</data><data key="n_module_id">rho_erythropolis_afb1_reduction</data><data key="n_entity_class">enzyme_cluster</data><data key="n_identifier">FDR-A / FDR-B homologs</data><data key="n_description">F420-dependent oxidoreductase family; catalyzes reductive detoxification of AFB1.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC3187090/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="strain:rho_anm7"><data key="n_label">Rhodococcus sp. ANM-7</data><data key="n_node_type">strain</data><data key="n_strain_id">rho_anm7</data><data key="n_module_id" /><data key="n_entity_class">organism</data><data key="n_identifier">GenBank AY177363 (16S)</data><data key="n_description">Aerobic Rhodococcus soil isolate; grows on N-nitrosodimethylamine (NDMA) as sole nitrogen source. Uses aerobic monooxygenase-mediated NDMA degradation, in contrast to the mammalian CYP2E1 route that generates methylating intermediates.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/16269791/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="module:rho_anm7_ndma_degradation"><data key="n_label">Rhodococcus sp. ANM-7 NDMA-degradation module</data><data key="n_node_type">module</data><data key="n_strain_id">rho_anm7</data><data key="n_module_id">rho_anm7_ndma_degradation</data><data key="n_entity_class">pathway_module</data><data key="n_identifier" /><data key="n_description">Aerobic monooxygenase pathway: NDMA is oxidized via propane monooxygenase-related enzymes to methylamine and formaldehyde intermediates that enter central metabolism.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/16269791/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="gene:rho_prmo_ndma"><data key="n_label">Propane-monooxygenase homolog for NDMA (Rhodococcus sp. ANM-7)</data><data key="n_node_type">gene</data><data key="n_strain_id">rho_anm7</data><data key="n_module_id">rho_anm7_ndma_degradation</data><data key="n_entity_class">enzyme_cluster</data><data key="n_identifier">prmABCD homolog</data><data key="n_description">Aerobic soluble propane-monooxygenase-family enzyme; initiates NDMA oxidation.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/16269791/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="compound:afb1"><data key="n_label">Aflatoxin B1</data><data key="n_node_type">compound</data><data key="n_strain_id">shared</data><data key="n_module_id" /><data key="n_entity_class">mycotoxin</data><data key="n_identifier">AFB1</data><data key="n_description">Mycotoxin from Aspergillus flavus and A. parasiticus; potent liver carcinogen via CYP1A2/3A4-derived exo-8,9-epoxide.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/23023529/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="compound:afb1_reduced"><data key="n_label">AFB1 F420-reduced product</data><data key="n_node_type">compound</data><data key="n_strain_id">shared</data><data key="n_module_id" /><data key="n_entity_class">detoxification_product</data><data key="n_identifier">AFB1-reduced</data><data key="n_description">F420-dependent bacterial reduction of the AFB1 bisfuran; downstream product cannot form the mammalian exo-8,9-epoxide.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC3187090/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="compound:ndma"><data key="n_label">N-Nitrosodimethylamine</data><data key="n_node_type">compound</data><data key="n_strain_id">shared</data><data key="n_module_id" /><data key="n_entity_class">nitrosamine</data><data key="n_identifier">NDMA</data><data key="n_description">Small volatile nitrosamine; potent CYP2E1 substrate in mammalian bioactivation to methylating species.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/16269791/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="compound:methylamine"><data key="n_label">Methylamine</data><data key="n_node_type">compound</data><data key="n_strain_id">shared</data><data key="n_module_id" /><data key="n_entity_class">aliphatic_amine</data><data key="n_identifier">methylamine</data><data key="n_description">Aerobic bacterial catabolic intermediate downstream of NDMA oxidation.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/16269791/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="strain:bthet_vpi5482"><data key="n_label">Bacteroides thetaiotaomicron VPI-5482</data><data key="n_node_type">strain</data><data key="n_strain_id">bthet_vpi5482</data><data key="n_module_id" /><data key="n_entity_class">organism</data><data key="n_identifier">NCBI Taxonomy 226186</data><data key="n_description">Abundant colonic Bacteroidetes; two catabolic modules relevant to xenobiotic handling. Azoreductase activity reduces aromatic-amine precursors; beta-glucuronidase deconjugates host-glucuronidated substrates including AFB1-N7-guanine glucuronide, releasing free carcinogen back into the lumen.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/12663928/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="module:bthet_azo_reduction"><data key="n_label">B. thetaiotaomicron gut azo-reduction module</data><data key="n_node_type">module</data><data key="n_strain_id">bthet_vpi5482</data><data key="n_module_id">bthet_azo_reduction</data><data key="n_entity_class">pathway_module</data><data key="n_identifier" /><data key="n_description">FMN-dependent azoreductase system; reductive cleavage of azo bonds. Handles aromatic amine precursor substrates including azo-linked benzidine and aminobiphenyl dyes.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC5715131/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="module:bthet_beta_glucuronidase"><data key="n_label">B. thetaiotaomicron beta-glucuronidase deconjugation module</data><data key="n_node_type">module</data><data key="n_strain_id">bthet_vpi5482</data><data key="n_module_id">bthet_beta_glucuronidase</data><data key="n_entity_class">pathway_module</data><data key="n_identifier" /><data key="n_description">Gut microbial beta-glucuronidase (GUS) family; hydrolyzes host-conjugated glucuronides in the intestinal lumen, releasing free aglycones back for reabsorption. Relevant to AFB1 detoxification counter-currents and other host-glucuronidated carcinogens.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC5389526/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="gene:bthet_azor"><data key="n_label">FMN-dependent azoreductase (B. thetaiotaomicron)</data><data key="n_node_type">gene</data><data key="n_strain_id">bthet_vpi5482</data><data key="n_module_id">bthet_azo_reduction</data><data key="n_entity_class">enzyme_cluster</data><data key="n_identifier">BT_1017 (azoR homolog)</data><data key="n_description">FMN-dependent azoreductase; reductive cleavage of azo bonds.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC5715131/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="gene:bthet_gus"><data key="n_label">Beta-glucuronidase (B. thetaiotaomicron)</data><data key="n_node_type">gene</data><data key="n_strain_id">bthet_vpi5482</data><data key="n_module_id">bthet_beta_glucuronidase</data><data key="n_entity_class">enzyme_cluster</data><data key="n_identifier">BT_3086 (loop 1 GUS)</data><data key="n_description">Loop-1 beta-glucuronidase; hydrolyzes glucuronide conjugates released via biliary excretion.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC5389526/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="strain:vpar_dsm2008"><data key="n_label">Veillonella parvula DSM 2008</data><data key="n_node_type">strain</data><data key="n_strain_id">vpar_dsm2008</data><data key="n_module_id" /><data key="n_entity_class">organism</data><data key="n_identifier">NCBI Taxonomy 479436</data><data key="n_description">Oral commensal (tongue biofilm) with anaerobic nitrate reductase (nap-type). Reduces salivary nitrate to nitrite; the second step (nitrite to nitric oxide and further) is oxygen-limited, so the oral cavity is not a strong endogenous nitrosation site. Provides ecosystem_outsourced reference for the nitrosamine axis.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC4462107/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="module:vpar_oral_nitrate_reduction"><data key="n_label">V. parvula oral nitrate-reduction module</data><data key="n_node_type">module</data><data key="n_strain_id">vpar_dsm2008</data><data key="n_module_id">vpar_oral_nitrate_reduction</data><data key="n_entity_class">pathway_module</data><data key="n_identifier" /><data key="n_description">Periplasmic nitrate-reductase (nap-type) system; canonical driver of the entero-salivary nitrate cycle.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC4462107/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="gene:vpar_nap"><data key="n_label">Napa periplasmic nitrate reductase (V. parvula)</data><data key="n_node_type">gene</data><data key="n_strain_id">vpar_dsm2008</data><data key="n_module_id">vpar_oral_nitrate_reduction</data><data key="n_entity_class">enzyme_cluster</data><data key="n_identifier">napA/napB homologs</data><data key="n_description">Periplasmic nitrate reductase; nitrate to nitrite.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC4462107/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="compound:azo_4abp_dye"><data key="n_label">Azo-linked 4-aminobiphenyl precursor</data><data key="n_node_type">compound</data><data key="n_strain_id">shared</data><data key="n_module_id" /><data key="n_entity_class">azo_dye</data><data key="n_identifier">azo-4ABP</data><data key="n_description">Representative azo-linked aromatic-amine precursor; reductive cleavage by gut azoreductase releases free 4-ABP.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC5715131/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="compound:afb1_n7_gluc"><data key="n_label">AFB1-N7-guanine glucuronide</data><data key="n_node_type">compound</data><data key="n_strain_id">shared</data><data key="n_module_id" /><data key="n_entity_class">glucuronide_conjugate</data><data key="n_identifier">AFB1-N7-guanine-Gluc</data><data key="n_description">Host-conjugated AFB1-derived glucuronide; substrate for microbial beta-glucuronidase deconjugation.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC5389526/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="compound:nitrate"><data key="n_label">Nitrate</data><data key="n_node_type">compound</data><data key="n_strain_id">shared</data><data key="n_module_id" /><data key="n_entity_class">inorganic_nitrogen</data><data key="n_identifier">NO3-</data><data key="n_description">Dietary nitrate entering the entero-salivary cycle.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC4462107/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="compound:nitrite"><data key="n_label">Nitrite</data><data key="n_node_type">compound</data><data key="n_strain_id">shared</data><data key="n_module_id" /><data key="n_entity_class">inorganic_nitrogen</data><data key="n_identifier">NO2-</data><data key="n_description">Reduced product of oral nitrate reduction; feeds N-nitrosation reactions in acidic stomach.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC4462107/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="strain:mvan_pyr1"><data key="n_label">Mycobacterium vanbaalenii PYR-1</data><data key="n_node_type">strain</data><data key="n_strain_id">mvan_pyr1</data><data key="n_module_id" /><data key="n_entity_class">organism</data><data key="n_identifier">NCBI Taxonomy 350058</data><data key="n_description">Aerobic actinomycete; canonical bacterial degrader of high-molecular-weight PAHs including pyrene, chrysene, and benzo[a]pyrene. Uses ring-hydroxylating dioxygenases (NidAB, PdoAB) that attack multiple ring positions in BaP, producing cis-dihydrodiols that feed downstream aerobic catabolism. Distinct from mammalian CYP1A1/1B1-derived arene-oxide route.</data><data key="n_source_url">https://pubmed.ncbi.nlm.nih.gov/17434969/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="module:mvan_pyr1_highmw_pah"><data key="n_label">M. vanbaalenii PYR-1 high-MW PAH degradation module</data><data key="n_node_type">module</data><data key="n_strain_id">mvan_pyr1</data><data key="n_module_id">mvan_pyr1_highmw_pah</data><data key="n_entity_class">pathway_module</data><data key="n_identifier" /><data key="n_description">Ring-hydroxylating dioxygenase system: NidAB (nid) and PdoAB (pdo) large-subunit dioxygenases attack multiple ring positions in pyrene, chrysene, and benzo[a]pyrene. Feeds meta-cleavage and further oxidative catabolism.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC3230965/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="gene:mvan_nidab"><data key="n_label">NidAB PAH ring-hydroxylating dioxygenase (M. vanbaalenii)</data><data key="n_node_type">gene</data><data key="n_strain_id">mvan_pyr1</data><data key="n_module_id">mvan_pyr1_highmw_pah</data><data key="n_entity_class">enzyme_cluster</data><data key="n_identifier">Mvan_0546-Mvan_0547 (nidA nidB)</data><data key="n_description">PAH-active ring-hydroxylating dioxygenase; catalyzes initial oxidative attack on high-MW PAH substrates including pyrene and benzo[a]pyrene.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC3230965/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="gene:mvan_pdoab"><data key="n_label">PdoAB PAH ring-hydroxylating dioxygenase (M. vanbaalenii)</data><data key="n_node_type">gene</data><data key="n_strain_id">mvan_pyr1</data><data key="n_module_id">mvan_pyr1_highmw_pah</data><data key="n_entity_class">enzyme_cluster</data><data key="n_identifier">Mvan_0470-Mvan_0471 (pdoA pdoB)</data><data key="n_description">Second PAH ring-hydroxylating dioxygenase system; complements NidAB for broader PAH substrate range.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC3230965/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="compound:pyrene"><data key="n_label">Pyrene</data><data key="n_node_type">compound</data><data key="n_strain_id">shared</data><data key="n_module_id" /><data key="n_entity_class">polycyclic_aromatic_hydrocarbon</data><data key="n_identifier">pyrene</data><data key="n_description">Four-ring high-MW PAH; canonical substrate for M. vanbaalenii PYR-1 ring-hydroxylating dioxygenases.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC3230965/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="compound:pyrene_dihydrodiol"><data key="n_label">Pyrene-4,5-cis-dihydrodiol (bacterial)</data><data key="n_node_type">compound</data><data key="n_strain_id">shared</data><data key="n_module_id" /><data key="n_entity_class">aromatic_intermediate</data><data key="n_identifier">pyrene-dihydrodiol</data><data key="n_description">cis-dihydrodiol product of NidAB/PdoAB attack on pyrene; feeds meta-cleavage catabolism.</data><data key="n_source_url">https://pmc.ncbi.nlm.nih.gov/articles/PMC3230965/</data><data key="n_kegg_gene_ids" /><data key="n_ko_ids" /><data key="n_ec_numbers" /><data key="n_kegg_pathways" /><data key="n_kegg_modules" /><data key="n_ncbi_protein_ids" /><data key="n_uniprot_ids" /><data key="n_pubchem_cid" /><data key="n_kegg_compound" /><data key="n_chebi_id" /><data key="n_metacyc_candidate" /><data key="n_metacyc_status" /><data key="n_annotation_status">seed_curated</data></node><node id="gene:gme_Gmet_1538"><data key="n_label">Gmet_1538 bssB</data><data key="n_node_type">gene</data><data key="n_strain_id">gmet_gs15</data><data key="n_module_id">gmet_aromatics</data><data key="n_entity_class">individual_locus</data><data key="n_identifier">Gmet_1538</data><data key="n_description">(GenBank) (R)-benzylsuccinate synthase, beta subunit</data><data key="n_source_url">https://rest.kegg.jp/get/gme:Gmet_1538</data><data key="n_kegg_gene_ids">gme:Gmet_1538</data><data key="n_ko_ids">K29040</data><data key="n_ec_numbers">4.1.99.11</data><data key="n_kegg_pathways">gme00623;g